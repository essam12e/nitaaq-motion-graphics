              "id": {
                "type": "string"
              },
              "beat": {
                "type": "string",
                "enum": [
                  "hook",
                  "problem",
                  "solution",
                  "demo",
                  "feature",
                  "product",
                  "offer",
                  "proof",
                  "data",
                  "social",
                  "process",
                  "comparison",
                  "brand",
                  "bridge",
                  "tease",
                  "reveal",
                  "montage",
                  "detail",
                  "map",
                  "cta"
                ]
              },
              "purpose": {
                "type": "string"
              },
              "start": {
                "type": "number"
              },
              "duration": {
                "type": "number"
              },
              "visibleMessage": {
                "type": "string"
              },
              "supportingVisual": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "variant": {
                "type": "string"
              },
              "composition": {
                "type": "string"
              },
              "movement": {
                "type": "string"
              },
              "transition": {
                "type": "string"
              },
              "soundEvents": {
                "type": "array",
