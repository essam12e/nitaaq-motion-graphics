                  "type": "string"
                }
              },
              "narration": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "number"
                  },
                  "end": {
                    "type": "number"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "emphasis": {
                "type": "string"
              },
              "ctaRelation": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "beat",
              "purpose",
              "start",
              "duration",
              "visibleMessage",
              "supportingVisual",
              "family",
              "variant",
              "composition",
              "movement",
              "transition",
              "soundEvents",
              "emphasis",
              "ctaRelation"
            ],
            "additionalProperties": false
          }
