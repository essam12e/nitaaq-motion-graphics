# Arabic Motion Director — environment (copy to .env or export in your shell).
# Secrets live ONLY here/in the environment. They are never written to brief.json,
# video.json, Studio projects or logs. Never commit a filled-in .env.

# Paths (optional; default ./workspace/…)
MOTION_WORKSPACE=
MOTION_UPLOADS=
MOTION_OUTPUT=
MOTION_CACHE=

# Premium TTS (optional — without a key, voiceover mode "tts" is refused; no robotic fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
OPENAI_API_KEY=
MOTION_TTS_PROVIDER=

# Optional overrides
MOTION_FFMPEG=
MOTION_FFPROBE=
STUDIO_PORT=4455
STUDIO_HOST=127.0.0.1
